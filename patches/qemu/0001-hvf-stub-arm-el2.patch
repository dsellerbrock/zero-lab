From: Zero Lab
Subject: [PATCH] accel/stubs: stub hvf_arm_el2_supported() for non-HVF builds

hw/arm/bcm2836.c is common (built once) code, so it sees the extern
declaration of hvf_arm_el2_supported(), but target/arm/hvf/hvf.c only
exists on macOS. Linux and Windows builds then fail to link raspi3ap.
The stub library is only pulled in when HVF is absent, like the others here.

--- a/accel/stubs/hvf-stub.c
+++ b/accel/stubs/hvf-stub.c
@@ -8,6 +8,7 @@
 
 #include "qemu/osdep.h"
 #include "system/hvf.h"
+#include "target/arm/hvf_arm.h"
 
 bool hvf_allowed;
 bool hvf_kernel_irqchip;
@@ -22,3 +23,9 @@ void hvf_nested_virt_enable(bool nested_virt)
      * As such, do nothing here instead of marking as unreachable.
      */
 }
+
+bool hvf_arm_el2_supported(void)
+{
+    /* Called from common raspi board code; this build has no HVF. */
+    return false;
+}
